{
  "manifest_version": 3,
  "name": "PhishNetra",
  "version": "1.0",
  "description": "A lightweight cybersecurity assistant that guards you against suspicious and dangerous websites.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webNavigation",
    "activeTab",
    "history",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishNetra",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["sound.mpeg"],
      "matches": ["<all_urls>"]
    }
  ]
}
